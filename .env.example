# Wszystkie wartości mają sensowne domyślne — plik jest opcjonalny.

# Model bazowy pobierany przez ollama-init (musi wspierać tool calling)
MODEL=qwen2.5:3b

# Liczba wątków inferencji zapisywana w modelu pochodnym router-model.
# 4 jest bezpieczne dla maszyn ARM/VM; na mocnym x86 można podnieść.
NUM_THREAD=4

# --- tylko dla uruchomienia natywnego (dev), compose ustawia je sam ---
# OLLAMA_URL=http://localhost:11434
# SMTP_HOST=localhost
# SMTP_PORT=1025
